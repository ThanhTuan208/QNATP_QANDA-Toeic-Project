{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach Next.js Server",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "sourceMaps": true
    },
    {
      "name": "Launch Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "skipFiles": ["node_modules/**"]
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack",
      "configurations": ["Attach Next.js Server", "Launch Edge"]
    }
  ]
}
